#!/usr/bin/env node

import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { dirname, delimiter, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2);
const ownDir = dirname(fileURLToPath(import.meta.url));

// Nested shell commands have no authority to call the host read carrier.
// Qoder reads approved repositories through its native, invocation-bound MCP.
// (fork capability, kept from e61291c03; must stay ahead of any content
// processing so read-only mode never inspects or forwards payload data)
if (process.env.CAT_CAFE_GITHUB_READ_ONLY === 'true') {
  if (args.length === 1 && args[0] === '--version') {
    process.stdout.write('gh (Clowder readonly carrier)\n');
    process.exit(0);
  }
  process.stderr.write('capability_unavailable: use mcp__clowder-repository-read__github_read\n');
  process.exit(1);
}

// ZCode lease carrier: the repository-read MCP presentation is retired, so the
// isolated member keeps the canonical gh CLI as its call surface. This carrier
// maps the fixed read grammar onto the host-owned query endpoint, where the
// broker still enforces the invocation binding, repository allowlist, typed
// query schema, output bounds and timeouts, and where gh itself runs with host
// credentials that never enter this process. The lease file is scoped to this
// member process's own runtime directory (the same 0600 directory that holds
// its generated provider input), so overlapping invocations never read each
// other's capability; it is removed with the process. Like the read-only
// branch above it must answer before the secret helpers load and must not
// import scripts/lib.
const READ_CARRIER_COMMANDS = new Map([
  ['pr view', { op: 'pr_view', id: 'number', json: true }],
  ['pr diff', { op: 'pr_diff', id: 'number', color: true }],
  ['pr checks', { op: 'pr_checks', id: 'number', json: true }],
  ['pr list', { op: 'pr_list', list: true, json: true, states: ['open', 'closed', 'merged', 'all'] }],
  ['issue view', { op: 'issue_view', id: 'number', json: true }],
  ['issue list', { op: 'issue_list', list: true, json: true, states: ['open', 'closed', 'all'] }],
  ['run view', { op: 'run_view', id: 'runId', json: true }],
  ['run list', { op: 'run_list', list: true, json: true }],
]);
const READ_CARRIER_FIELDS = {
  pr_view: 'body,headRefOid,isDraft,number,state,title,updatedAt,url',
  pr_list: 'headRefOid,isDraft,number,state,title,updatedAt,url',
  pr_checks: 'bucket,link,name,state,workflow',
  issue_view: 'body,number,state,title,updatedAt,url',
  issue_list: 'number,state,title,updatedAt,url',
  run_view: 'conclusion,databaseId,displayTitle,headSha,status,url,workflowName',
  run_list: 'conclusion,databaseId,displayTitle,headSha,status,url,workflowName',
};

if (process.env.CAT_CAFE_GH_READ_CARRIER === 'lease') {
  process.exit(await runLeaseCarrier(args));
}

function leaseCarrierFail(code, detail) {
  process.stderr.write(`${code}: ${detail}\n`);
  process.exit(1);
}

function readLeaseCarrierLease() {
  // Bind to this member process's own runtime directory. There is
  // deliberately no shared-HOME fallback: one global file would let
  // overlapping invocations spend each other's lease.
  const providerConfig = process.env.ZCODE_PERSONAL_PROVIDER_CONFIG_FILE;
  const file =
    process.env.CAT_CAFE_GH_READ_LEASE_FILE ??
    (providerConfig ? join(dirname(providerConfig), 'gh-read-lease.json') : undefined);
  if (!file) return undefined;
  let parsed;
  try {
    parsed = JSON.parse(readFileSync(file, 'utf8'));
  } catch {
    return undefined;
  }
  try {
    const url = new URL(parsed.url);
    if (
      url.protocol !== 'http:' ||
      !['127.0.0.1', '[::1]'].includes(url.hostname) ||
      url.username ||
      url.password ||
      url.search ||
      url.hash ||
      url.pathname !== '/api/agent-github-read'
    )
      return undefined;
  } catch {
    return undefined;
  }
  return typeof parsed.token === 'string' && /^[A-Za-z0-9_-]{43}$/.test(parsed.token)
    ? { url: parsed.url, token: parsed.token }
    : undefined;
}

/** Strict local shaping of the eight fixed reads; the broker schema stays the authority. */
function parseLeaseCarrierQuery(argv) {
  let repo;
  let json;
  let state;
  let limit;
  let color;
  const positional = [];
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    const pair = (name) => (arg === name ? argv[++index] : arg.startsWith(`${name}=`) ? arg.slice(name.length + 1) : undefined);
    const value = pair('--repo') ?? pair('-R');
    if (value !== undefined && value !== true) {
      repo = value;
      continue;
    }
    const jsonValue = pair('--json');
    if (jsonValue !== undefined && jsonValue !== true) {
      json = jsonValue;
      continue;
    }
    const stateValue = pair('--state');
    if (stateValue !== undefined && stateValue !== true) {
      state = stateValue;
      continue;
    }
    const limitValue = pair('--limit');
    if (limitValue !== undefined && limitValue !== true) {
      limit = limitValue;
      continue;
    }
    const colorValue = pair('--color');
    if (colorValue !== undefined && colorValue !== true) {
      color = colorValue;
      continue;
    }
    if (arg.startsWith('-')) leaseCarrierFail('capability_unavailable', `unsupported gh option in read carrier: ${arg}`);
    positional.push(arg);
  }
  const head = positional.slice(0, 2).join(' ');
  const config = READ_CARRIER_COMMANDS.get(head);
  if (!config || positional.length > (config.list ? 2 : 3))
    leaseCarrierFail(
      'capability_unavailable',
      'read carrier supports only: pr view|diff|checks|list, issue view|list, run view|list --repo owner/name',
    );
  const query = { op: config.op };
  if (!repo) leaseCarrierFail('capability_unavailable', 'read carrier requires an explicit --repo owner/name');
  const normalized = repo.replace(/^github\.com\//i, '').toLowerCase();
  if (!/^[a-z0-9][a-z0-9-]*\/[a-z0-9_.-]+$/.test(normalized))
    leaseCarrierFail('capability_unavailable', `unsupported repository: ${repo}`);
  query.repo = normalized;
  if (config.list) {
    if (config.states) {
      query.state = state ?? 'open';
      if (!config.states.includes(query.state))
        leaseCarrierFail('capability_unavailable', `unsupported --state for ${config.op}: ${query.state}`);
    } else if (state !== undefined) {
      leaseCarrierFail('capability_unavailable', `--state is not valid for ${config.op}`);
    }
    const parsedLimit = limit === undefined ? 30 : Number(limit);
    if (!Number.isInteger(parsedLimit) || parsedLimit < 1 || parsedLimit > 50)
      leaseCarrierFail('capability_unavailable', `unsupported --limit for ${config.op}: ${limit}`);
    query.limit = parsedLimit;
    if (color !== undefined) leaseCarrierFail('capability_unavailable', `--color is not valid for ${config.op}`);
  } else {
    const id = positional[2];
    const parsedId = Number(id);
    if (id === undefined || !Number.isInteger(parsedId) || parsedId < 1)
      leaseCarrierFail('capability_unavailable', `${config.op} requires a positive integer number`);
    query[config.id] = parsedId;
    if (state !== undefined) leaseCarrierFail('capability_unavailable', `--state is not valid for ${config.op}`);
    if (limit !== undefined) leaseCarrierFail('capability_unavailable', `--limit is not valid for ${config.op}`);
    if (config.color && color !== undefined && color !== 'never')
      leaseCarrierFail('capability_unavailable', `unsupported --color for ${config.op}: ${color}`);
    if (!config.color && color !== undefined)
      leaseCarrierFail('capability_unavailable', `--color is not valid for ${config.op}`);
  }
  if (json !== undefined) {
    if (!config.json) leaseCarrierFail('capability_unavailable', `--json is not valid for ${config.op}`);
    const wanted = json.split(',').map((field) => field.trim()).sort().join(',');
    if (wanted !== READ_CARRIER_FIELDS[config.op])
      leaseCarrierFail('capability_unavailable', `read carrier serves the fixed field set for ${config.op}`);
  }
  return query;
}

async function runLeaseCarrier(argv) {
  if (argv.length === 1 && argv[0] === '--version') {
    process.stdout.write('gh (Clowder readonly carrier)\n');
    return 0;
  }
  const query = parseLeaseCarrierQuery(argv);
  const lease = readLeaseCarrierLease();
  if (!lease) leaseCarrierFail('capability_unavailable', 'no active GitHub read lease for this invocation');
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(new Error('timeout')), 20_000);
  const cancel = () => controller.abort(new Error('cancelled'));
  process.once('SIGINT', cancel);
  process.once('SIGTERM', cancel);
  try {
    const response = await fetch(lease.url, {
      method: 'POST',
      headers: { authorization: `Bearer ${lease.token}`, 'content-type': 'application/json' },
      body: JSON.stringify(query),
      signal: controller.signal,
    });
    const text = await response.text();
    let result;
    try {
      result = JSON.parse(text);
    } catch {
      result = undefined;
    }
    if (response.status === 401 || !result)
      leaseCarrierFail('gh_read_failed', response.status === 401 ? 'authentication_required' : 'unavailable');
    if (result.ok !== true) leaseCarrierFail('gh_read_failed', `${result.code ?? 'unavailable'}`);
    process.stdout.write(`${JSON.stringify(result.data)}\n`);
    return 0;
  } catch (error) {
    const reason = error instanceof Error && error.message === 'cancelled' ? 'cancelled' : 'unavailable';
    leaseCarrierFail('gh_read_failed', reason);
  } finally {
    clearTimeout(timer);
    process.off('SIGINT', cancel);
    process.off('SIGTERM', cancel);
  }
}

// The controlled Qoder sandbox mounts this wrapper but not scripts/lib, and the
// `gh --version` canary is classified under the workspace policy. Resolve the
// secret helpers only after the read-only carrier has answered or refused, so a
// read-only runtime without the lib mount can still start. Every non-read-only
// invocation loads the same helpers before it inspects or forwards any content.
const { prepareSecretSafeSend } = await import('../lib/secret-outbound-args.mjs');
const { assertSecretFree } = await import('../lib/secret-payload-files.mjs');
const { executeSecretSafeCommand } = await import('../lib/secret-command-execution.mjs');

let prepared;
try {
  assertSecretFree(args.join('\n'));
} catch {
  process.stderr.write('secret_send_blocked: content was unsafe or could not be inspected; use explicit body/file input.\n');
  process.exit(1);
}
process.on('exit', () => prepared?.dispose());

const VALUE_OPTION_ALIASES = Object.freeze({
  repository: Object.freeze(['--repo', '-R']),
  title: Object.freeze(['--title', '-t']),
  head: Object.freeze(['--head', '-H']),
  base: Object.freeze(['--base', '-B']),
});

function valueOptionAt(index, names) {
  const arg = args[index];
  if (names.includes(arg)) {
    return { value: args[index + 1], width: args[index + 1] === undefined ? 1 : 2 };
  }
  for (const name of names) {
    const prefix = `${name}=`;
    if (arg.startsWith(prefix)) return { value: arg.slice(prefix.length), width: 1 };
    if (/^-[^-]$/.test(name) && arg.startsWith(name) && arg.length > name.length) {
      return { value: arg.slice(name.length), width: 1 };
    }
  }
  return undefined;
}

function optionValues(option) {
  const names = VALUE_OPTION_ALIASES[option];
  const values = [];
  for (let index = 0; index < args.length; index += 1) {
    const parsed = valueOptionAt(index, names);
    if (!parsed) continue;
    if (parsed.value !== undefined) values.push(parsed.value);
    index += parsed.width - 1;
  }
  return values;
}

function optionValue(option) {
  return optionValues(option).at(-1);
}

function commandArgs() {
  let index = 0;
  while (index < args.length) {
    const arg = args[index];
    const repository = valueOptionAt(index, VALUE_OPTION_ALIASES.repository);
    if (repository) {
      index += repository.width;
      continue;
    }
    const hostname = valueOptionAt(index, ['--hostname']);
    if (hostname) {
      index += hostname.width;
      continue;
    }
    if (arg === 'pr') {
      index += 1;
      while (index < args.length) {
        const inheritedRepository = valueOptionAt(index, VALUE_OPTION_ALIASES.repository);
        if (!inheritedRepository) break;
        index += inheritedRepository.width;
      }
      return ['pr', ...args.slice(index)];
    }
    if (!arg.startsWith('-')) return args.slice(index);
    index += 1;
  }
  return [];
}

function gitOutput(gitArgs) {
  const result = spawnSync('git', gitArgs, { encoding: 'utf8' });
  return result.status === 0 ? result.stdout.trim() : '';
}

function candidateTouchesVerdictArtifacts() {
  const baseBranch = optionValue('base') ?? 'main';
  const remoteBase = `refs/remotes/origin/${baseBranch}`;
  const baseRef = gitOutput(['rev-parse', '--verify', remoteBase]) ? remoteBase : baseBranch;
  const paths = gitOutput(['diff', '--name-only', `${baseRef}...HEAD`]);
  return paths.split('\n').some(
    (path) =>
      path.startsWith('docs/harness-feedback/bundles/') ||
      path.startsWith('docs/harness-feedback/verdicts/') ||
      path === 'docs/harness-feedback/registry/measurement-bundles.yaml',
  );
}

function isVerdictPrCreate() {
  const command = commandArgs();
  if (command[0] !== 'pr' || !['create', 'new'].includes(command[1])) return false;
  const title = optionValue('title') ?? '';
  const head = optionValue('head') ?? '';
  const branch = gitOutput(['branch', '--show-current']);
  const commitSubject = gitOutput(['log', '-1', '--pretty=%s']);
  return (
    title.startsWith('verdict(') ||
    head.includes('verdict/auto/') ||
    branch.startsWith('verdict/auto/') ||
    commitSubject.startsWith('verdict(') ||
    candidateTouchesVerdictArtifacts()
  );
}

function fail(code, detail) {
  process.stderr.write(`${code}: ${detail}\n`);
  process.exit(1);
}

if (isVerdictPrCreate()) {
  // Fork verdict publishing targets the cat-cafe evaluation repository.
  // deploymentDefaults in this checkout resolves to zts212653/clowder-ai
  // (opensource profile), which would silently retarget fork verdict PRs;
  // keep the fork fallback until the fork explicitly decides to migrate.
  const expectedRepo =
    process.env.CAT_CAFE_VERDICT_REPO_FULL_NAME ??
    process.env.CAT_CAFE_REPO_FULL_NAME ??
    'zts212653/cat-cafe';
  const explicitRepos = optionValues('repository');
  if (explicitRepos.length === 0) {
    fail('verdict_publish_missing_repo_scope', `verdict PR creation requires --repo ${expectedRepo}`);
  }
  const wrongRepo = explicitRepos.find((repo) => repo.toLowerCase() !== expectedRepo.toLowerCase());
  if (wrongRepo) {
    fail(
      'verdict_publish_wrong_repository',
      `gh --repo resolves to ${wrongRepo}; expected ${expectedRepo}`,
    );
  }

  const guardRoot = process.env.CAT_CAFE_VERDICT_GH_GUARD_ROOT;
  if (!guardRoot) {
    fail('verdict_publish_guard_unavailable', 'CAT_CAFE_VERDICT_GH_GUARD_ROOT is not configured');
  }
  const repoRoot = gitOutput(['rev-parse', '--show-toplevel']);
  if (!repoRoot) fail('verdict_publish_guard_unavailable', 'current directory is not a git repository');
  const baseBranch = optionValue('base') ?? 'main';
  const guard = spawnSync(
    process.execPath,
    [
      resolve(guardRoot, 'scripts/check-verdict-publish-contract.mjs'),
      '--repo-root',
      repoRoot,
      '--expected-repo',
      expectedRepo,
      '--remote',
      'origin',
      '--fresh-base-branch',
      baseBranch,
      '--source-ref',
      'HEAD',
    ],
    { encoding: 'utf8' },
  );
  if (guard.status !== 0) {
    process.stderr.write(guard.stderr || 'verdict_publish_guard_failed\n');
    process.exit(guard.status ?? 1);
  }
}

const delegatePath = (process.env.PATH ?? '')
  .split(delimiter)
  .filter((entry) => entry && resolve(entry) !== resolve(ownDir))
  .join(delimiter);
const delegate = process.env.CAT_CAFE_REAL_GH_PATH ?? 'gh';
try {
  prepared = await prepareSecretSafeSend('gh', args);
} catch {
  fail('secret_send_blocked', 'content was unsafe or could not be inspected; use explicit body/file input.');
}
process.exit(await executeSecretSafeCommand(delegate, prepared.args, { ...process.env, PATH: delegatePath }));
